PORT=3000

# Set this to something private and hard to guess.
# You'll use it as ?key=YOUR_ADMIN_KEY to view leads at /admin
ADMIN_KEY=change-this-to-something-secret

# CTA button: pick ONE of these two options.
# Option A — WhatsApp (recommended, fastest for Indian users):
# Full number with country code, no +, no spaces, e.g. 919876543210
WHATSAPP_NUMBER=
WHATSAPP_MESSAGE=Hi, I just checked my resume and skill score on the NeuraPath tool and I'd like to talk about a course.

# Option B — Calendly (used only if WHATSAPP_NUMBER is left blank):
CALENDLY_URL=
